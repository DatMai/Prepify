NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://localhost/quiz_app
# Used by the new opaque session layer. Generate a random value of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
CONTENT_ROOT=../content
SESSION_TTL_HOURS=168
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
APP_TIME_ZONE=Asia/Ho_Chi_Minh
EMAIL_DELIVERY_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
# Gmail requires a 16-character App Password (store it without spaces).
EMAIL_PASS=
EMAIL_FROM=Prepify <noreply@prepify.dev>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local-only Obsidian bridge. Keep disabled on hosted environments.
OBSIDIAN_SYNC_ENABLED=false
OBSIDIAN_VAULT_PATH=/absolute/path/to/second-brain
OBSIDIAN_TIME_ZONE=Asia/Ho_Chi_Minh
# Required when sync is enabled: only this Prepify account may use the vault.
OBSIDIAN_OWNER_EMAIL=you@example.com
# Identity of the hosted vault. The server stores no filesystem path for it.
OBSIDIAN_VAULT_ID=vault-main
# Hosted sync over the authenticated WebSocket channel used by the remote
# HeheVault bridge. When enabled, OBSIDIAN_BRIDGE_TOKEN is required and must be
# at least 32 characters. The credential is sent by the bridge in the
# Authorization header only; it never appears in a URL or a log record.
OBSIDIAN_BRIDGE_ENABLED=false
OBSIDIAN_BRIDGE_TOKEN=
# Comma-separated accounts allowed to access the private Library and Journey.
ADMIN_EMAILS=you@example.com
