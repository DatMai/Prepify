NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://localhost/quiz_app
# Used by the new opaque session layer. Generate a random value of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
APP_TIME_ZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Prepify <noreply@prepify.dev>

# Local-only Obsidian bridge. Keep disabled on hosted environments.
OBSIDIAN_SYNC_ENABLED=false
OBSIDIAN_VAULT_PATH=/absolute/path/to/second-brain
OBSIDIAN_TIME_ZONE=Asia/Ho_Chi_Minh
# Required when sync is enabled: only this Prepify account may use the vault.
OBSIDIAN_OWNER_EMAIL=you@example.com
# Comma-separated accounts allowed to access the private Library and Journey.
ADMIN_EMAILS=you@example.com
