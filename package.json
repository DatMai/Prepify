{
  "name": "prepify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "npm --prefix server run dev",
    "content:translate": "swift scripts/translate-content.swift",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check:bundle": "node scripts/privateBundleScan.mjs",
    "check:release-boundaries": "node scripts/releaseBoundaryScan.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high && npm --prefix server audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm --prefix server run typecheck && npm test && npm --prefix server test && npm run build && npm --prefix server run build && npm run check:bundle && npm run check:release-boundaries && npm run audit:production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
